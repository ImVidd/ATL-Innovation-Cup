# Copy to .env.local (never commit .env.local) and fill in values.
# With no GEMINI_API_KEY the app runs in mock mode (fake AI results).

# Gemini key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional model override
GEMINI_MODEL=gemini-flash-latest
# Set to true to force fake AI results even with a key
MOCK_AI=false

# Optional: Supabase saving. Without these, work lives only in the browser tab.
# Supabase dashboard -> Project Settings -> API (URL and secret / service_role key)
SUPABASE_URL=
SUPABASE_SECRET_KEY=
