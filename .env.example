# App
APP_NAME=TA Grader
DEBUG=true
API_V1_PREFIX=/api/v1

# Supabase (create free project at supabase.com)
# NOTE: Use your own dev project. Never put real keys in git.
# Share real values only via a password manager, not in commits/PRs.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_KEY=your-service-key-here

# Database (use Supabase PostgreSQL connection string)
DATABASE_URL=postgresql://postgres:[password]@db.your-project.supabase.co:5432/postgres

# Auth (Clerk - create free at clerk.com, or use Supabase Auth)
JWT_SECRET=change-me-generate-with-openssl-rand-hex-32
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=10080

# OpenAI (get key at platform.openai.com - each dev uses their own)
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o-mini

# Storage
STORAGE_BUCKET=submissions
MAX_FILE_SIZE_MB=50

# OCR (optional - set if tesseract not in PATH)
TESSERACT_CMD=
